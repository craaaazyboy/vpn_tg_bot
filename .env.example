# --- Mode selector ---
# Leave ONLY variables relevant to the chosen mode.

### All‑in‑one
#WG_HOST=vpn.example.com          # external address where this compose runs
#WG_JWT=LONG_RANDOM_TOKEN

### Remote‑API
WG_API_URL=http://77.221.145.27:51820/api
WG_JWT=LONG_RANDOM_TOKEN          # same token preset on VPN host


# === сеть WireGuard ===
WG_HOST=77.221.145.27
WG_PORT=49735
WG_JWT=LONG_RANDOM_TOKEN        # тот же в боте и в api

# === Telegram ===
BOT_TOKEN=7314028061:AAHJFBZN6vw6o52lvt3vDDJUij78EYVmgeY
ADMIN_ID=1715533439

# === Postgres (в docker-compose) ===
PG_USER=bot
PG_PASS=supersecret

DATABASE_URL=postgresql://bot:supersecret@postgres:5432/bot

# SSH-доступ к VPN-хосту
WG_SSH_HOST=77.221.145.27
WG_SSH_USER=root
WG_SSH_KEY=/run/secrets/vpn_ssh_key

# IKEv2/IPsec (strongSwan)
# If empty, bot will use WG_SSH_HOST as server address.
IKEV2_SERVER_ADDR=
# Remote ID (usually your VPN domain or the same IP)
IKEV2_REMOTE_ID=
# Path to CA certificate on server (PEM). Optional if your server manager script handles it.
IKEV2_CA_CERT_PATH=/root/ca/ca-cert.crt
# Helper script path on server used by the bot
IKEV2_SERVER_MANAGER=/usr/local/sbin/ikev2-bot.sh